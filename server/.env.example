# Omgevingsvariabelen voor de server. Kopieer naar `.env` en vul aan.
# Geen waarden in dit bestand, en `.env` gaat nooit mee in git.

# De sleutel waarmee tokens versleuteld in `connections` komen te staan.
# 32 bytes, base64. Maken:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Raakt deze sleutel kwijt, dan zijn alle opgeslagen tokens onbruikbaar en
# moet iedereen opnieuw koppelen.
BUNDEL_TOKEN_KEY=

# Waar de server zelf luistert. Zonder waarde wordt het 8787.
PORT=

# Het adres van de app, waar de gebruiker na het koppelen heen gaat. Lokaal is
# dat http://127.0.0.1:5179, live het adres op Vercel. Staat hij leeg, dan komt
# er een kale pagina in plaats van een doorverwijzing.
APP_BASE_URL=

# Supabase. Drie waarden, en let op welke waar hoort.
SUPABASE_URL=

# De service role key gaat langs RLS heen. Alleen `server/src/store/` gebruikt
# hem, en hij mag nooit in `web/`, nooit naar Vercel en nooit in een log.
SUPABASE_SERVICE_ROLE_KEY=

# De anon key, dezelfde als in `web/.env.example`. Niet geheim. De server
# gebruikt hem alleen om aan Supabase te vragen bij wie een sessie hoort.
SUPABASE_ANON_KEY=

# Canvas. Een developer key vraag je aan bij de beheerder van de instantie.
CANVAS_BASE_URL=
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=

# Microsoft, voor de bron Teams. Alle vier komen uit een app-registratie in
# Entra ID (Azure portal, Microsoft Entra ID, App registrations). Een beheerder
# van de tenant moet die registratie goedkeuren, anders komt niemand voorbij het
# inlogscherm. Welke rechten we vragen en waarom staat in server/README.md.

# De tenant waar de school in zit. Een GUID of een domein zoals school.nl.
# `common` kan ook, maar dan kan iedereen met een Microsoft-account inloggen en
# dat willen we niet.
MICROSOFT_TENANT_ID=

# Application (client) ID uit de app-registratie. Niet geheim.
MICROSOFT_CLIENT_ID=

# Client secret uit Certificates & secrets. Wel geheim, en hij verloopt.
# Zet een herinnering voor de vervaldatum, want daarna stopt de koppeling.
MICROSOFT_CLIENT_SECRET=

# Waar Microsoft de gebruiker na het inloggen naartoe stuurt. Dit adres moet
# letterlijk zo bij Redirect URIs in de app-registratie staan, anders weigert
# Microsoft de aanvraag.
MICROSOFT_REDIRECT_URI=
